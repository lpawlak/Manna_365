<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Wymuszenie bezpiecznego połączenia TLS/HTTPS dla wszystkich żądań sieciowych -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
